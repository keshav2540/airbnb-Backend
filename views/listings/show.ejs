<%-layout('layout/boilerplate') %>
<script>
  const map_token = "<%=process.env.MAP_TOKEN %>"
  const coordinates= <%-JSON.stringify(list.geometry.coordinates)%>
  const locate= <%-JSON.stringify(list.location)%>
</script>
<div class="row mt-3">
  <div class="col-10 offset-1 show-card">
    <h3><%= list.title %></h3>
  </div>
  <div class="card col-5 offset-1 listing-card">
    <img
      src="<%=list.image.url%>"
      class="card-img-top show-img"
      alt="listimage"
    />
    <div class="card-body">
      <p class="card-text">      
         Owner :<i><%= list.owner.username %></i><br>
        &#8377;<%= list.price.toLocaleString('en-IN')%><br />
        <%= list.location %><br />
        <%= list.country %><br />
        <i><%= list.description %></i><br />
      </p> 
      <% if(currUser && list.owner._id.equals(currUser._id)) {%>
      <div class="btns mt-3">
        <a href="/listings/<%=list._id %>/edit" class="btn btn-dark edit-button"
          >Edit</a>
        <form action="/listings/<%=list._id %>?_method=DELETE" method="POST">
          <button class="btn btn-dark">delete</button>
        </form>
      </div>
        <%} %>
   </div>
  </div>
<div class="col-5 reviews">
  <i><h6 class="mb-3">Reviews</h6></i>
  <div class="reviews-scroll">
    <% list.reviews.map((rev)=> { %>
      <div class="card mb-2">
        <div class="card-body">
          <h6><i> @<%=rev.author.username %></i></h6>
          
          <p class="card-text mb-1">
               <p class="starability-result" data-rating="<%= rev.rating %>">  </p>
          </p>
          <h5 class="card-title">
            <%=rev.comment %>
          </h5>
          <p class="card-text">
            <small class="text-muted">
              <%= rev.createdAt?rev.createdAt.toLocaleString("en-IN"):"N/A" %>
            </small>
          </p>
         <%if(rev.author.equals(currUser)) {%>
        <form action="/listings/<%= list._id %>/reviews/<%=rev._id%>?_method=DELETE" method="POST">
            <button class="btn btn-dark btn-sm">delete</button>
        </form>
        <%} %>
         </div>
      </div>
      <% }) %>
  </div>
</div>
<hr>
  <div class="col-10 offset-1 mb-3">
    <h1>Where You'll be</h1>
    <br>
    <div id="map" class="col-8 mb-3 card"></div>
  </div>
  </div>
<%if(currUser) {%>
 <hr class="mt-4">
  <div class="col-8 offset-1 mb-3">
    <h4>Leave A Review</h4>
    <form action="/listings/<%=list._id%>/reviews" method="post" novalidate class="needs-validation">
      <div>
        <label for="rating" class="form-label"> Rating</label>
        <!-- <input class="form-range"type="range" min="1" max="5" id="rating"name="review[rating]"> -->
        <fieldset class="starability-slot">
        <input type="radio" id="rating" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
        <label for="first-rate1" title="Terrible">1 star</label>
        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
        <label for="first-rate2" title="Not good">2 stars</label>
        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
        <label for="first-rate3" title="Average">3 stars</label>
        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
        <label for="first-rate4" title="Very good">4 stars</label>
        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
        <label for="first-rate5" title="Amazing">5 stars</label>
      </fieldset></div>
      <div>
        <label for="comment"  class="form-label"> Comments</label>
        <textarea  id="comment"name="review[comment]" cols="40" rows="5" class="form-control " required></textarea>
          <div class="invalid-feedback">
            Please provide a comment on this
          </div>
          <div class="valid-feedback">
            thanks for yours feedback
          </div>
      </div>
      <br>
      <button class="btn btn-outline-dark">Submit</button>
    </form>
    </div>
    <%}%>
 </div> 
 <script src="/javascript/map.js"></script>