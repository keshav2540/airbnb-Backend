<%-layout('layout/boilerplate') %>
<br>
<div class="row">
    <div class="col-8 offset-2">
    <form action="/listings/<%=list._id %>?_method=PUT"  method="POST" novalidate class="needs-validation" enctype="multipart/form-data">
        <h1> Edit House Details</h1>
        <div> <label for="title"> Title</label><br>
            <input type="text" placeholder="Add a catchy title" name="title" class="form-control"    value="<%= list.title %>" required />
            <div class="valid-feedback">
                Looks good!
            </div>
            <div class="invalid-feedback">
                Please provide a valid title
            </div><br>
        </div>
        <div class="mb-3">   
            Original Listing Image<br>
        <div style="width: 20rem;">
            <img src="<%=originalImage%>" class="card-img-top" alt="<%=list.image.filename %>" >
        </div>
    </div>
    <div class="mb-3">
        <label for="image">upload listing Image</label><br />
        <input type="file" id="image" name="image" class="form-control" accept=".png, .jpg, .jpeg" />
    </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price">price</label><br>
                <input type="number" placeholder="1500" id="price" name="price" class="form-control"  value="<%= list.price %>" required />
                <div class="invalid-feedback">
                    Please provide a valid price
                </div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country">country</label><br>
                <input type="text" placeholder="India" id="country" name="country" class="form-control"     value="<%= list.country %>" required />
                <div class="invalid-feedback">
                    Please provide a valid country
                </div>
            </div>
        </div>
    
        <div class="mb-3">
            <label for="location">location</label><br>
            <input type="text" placeholder="Jaipur,Rajasthan" id="location" name="location" class="form-control"  value="<%= list.location%>" required />
            <div class="invalid-feedback">
                Please provide a valid location
            </div>
        </div>
        <div class="mb-3">
            <label for="description">description </label><br>
            <textarea placeholder="about house" id="description" name="description" class="form-control" 
                required><%= list.description %></textarea>
            <div class="invalid-feedback">
                Please provide a valid description
            </div><br>
        </div><br> 
        <button class="btn btn-dark add-button" type="submit"> submit</button><br><br><br>
    </form>
    </div>
    </div>



